[Unit]
Description=Laravel Horizon Queue Worker
After=network.target valkey-server.service postgresql.service

[Service]
# The user and group that should run Horizon
User=www-data
Group=www-data

WorkingDirectory=/var/www/SledgeHammerTime

# Run Horizon via Laravel's artisan
ExecStart=/usr/bin/php artisan horizon
ExecStop=/usr/bin/php artisan horizon:terminate

# Restart if Horizon crashes or stops
Restart=always
RestartSec=3

# No EnvironmentFile=: Laravel reads .env itself from WorkingDirectory. systemd
# would parse it differently (no ${VAR} interpolation) and real environment
# variables beat dotenv, so Horizon would see a literal "${APP_NAME}". (The
# quoted path this unit used to have was silently ignored: "path is not
# absolute".)

[Install]
WantedBy=multi-user.target
